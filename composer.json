{
    "name": "swiftly/dependency",
    "description": "Straightforward dependency injection.",
    "homepage": "https://github.com/SwiftlyPHP/dependency",
    "readme": "README.md",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "vimeo/psalm": "^6.21",
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Swiftly\\Dependency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swiftly\\Dependency\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "style": "@php vendor/bin/php-cs-fixer fix --diff",
        "lint": "@php vendor/bin/php-cs-fixer check --diff",
        "analyse": "@php vendor/bin/psalm --show-info=true",
        "test:unit": "@php vendor/bin/phpunit --testsuite=unit",
        "test": ["@test:unit"],
        "check": ["@lint", "@analyse"]
    }
}
